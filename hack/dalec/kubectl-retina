#!/usr/bin/env bash
set -euo pipefail

: "${KUBECTL_RETINA_IMAGE:?The Dalec CLI image is required}"
: "${KUBECONFIG:?An admin kubeconfig is required}"
repo_root="$(git rev-parse --show-toplevel)"
kubeconfig="$(realpath "$KUBECONFIG")"
exec docker run --rm --network host --user "$(id -u):$(id -g)" \
  --mount "type=bind,src=$repo_root,dst=$repo_root" \
  --mount "type=bind,src=$kubeconfig,dst=/tmp/retina-kubeconfig,readonly" \
  --workdir "$PWD" \
  --env KUBECONFIG=/tmp/retina-kubeconfig --env HOME=/tmp \
  --env RETINA_AGENT_IMAGE \
  --entrypoint /kubectl-retina "$KUBECTL_RETINA_IMAGE" "$@"
