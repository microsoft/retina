# build stage
# skopeo inspect docker://mcr.microsoft.com/oss/go/microsoft/golang:1.26-azurelinux3.0 --format "{{.Name}}@{{.Digest}}"
FROM mcr.microsoft.com/oss/go/microsoft/golang:1.27-azurelinux3.0@sha256:93a33cd954e1611e965c4f1a2e06a7e85ecd663752549a332e0677ebdcafdb5a AS builder
